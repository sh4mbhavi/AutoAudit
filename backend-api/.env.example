# Local development settings
# Copy this file to .env and adjust as needed

# Database: set your local postgresql+asyncpg connection URL before starting.
DATABASE_URL=

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379

# OPA (Open Policy Agent)
OPA_URL=http://localhost:8181

# JWT signing key (MUST change in production)
SECRET_KEY=dev-secret-key-change-in-production

# Fernet encryption key for M365 credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must match docker-compose.yml ENCRYPTION_KEY for worker compatibility
# Generate a fresh local key before using connection storage; do not commit it.
ENCRYPTION_KEY=

# Policies directory (use relative path for local dev, /app/policies in Docker)
POLICIES_DIR=../engine/policies

# Optional explicit local bootstrap (never run automatically).
APP_ENV=dev
DEV_ADMIN_SEED_ENABLED=false
# Set your own email and a unique password of at least 16 characters before opting in.
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
