package cis.microsoft_365_foundations.v6_0_0.test_control_4_1

import rego.v1

# An unknown value for either setting makes the pair unknown: a tenant that has
# secureByDefault on and no reported scheduled-action setting has not been shown
# to fail, and must not be recorded as failing.

test_compliant if {
	result := data.cis.microsoft_365_foundations.v6_0_0.control_4_1.result with input as {"secure_by_default": true, "is_scheduled_action_enabled": true, "device_compliance_on_boarded": 30, "compliance_policy_summaries": []}
	object.get(result, "compliant", "undefined") == true
	is_string(result.message)
	count(result.message) > 0
	is_array(result.affected_resources)
	is_object(result.details)
	count(result.details) > 0
	result.affected_resources == []
}

test_non_compliant if {
	result := data.cis.microsoft_365_foundations.v6_0_0.control_4_1.result with input as {"secure_by_default": false, "is_scheduled_action_enabled": true}
	object.get(result, "compliant", "undefined") == false
	is_string(result.message)
	count(result.message) > 0
	is_array(result.affected_resources)
	is_object(result.details)
	count(result.details) > 0
	count(result.affected_resources) > 0
}

test_absent_evidence if {
	result := data.cis.microsoft_365_foundations.v6_0_0.control_4_1.result with input as {}
	object.get(result, "compliant", "undefined") == null
	is_string(result.message)
	count(result.message) > 0
	is_array(result.affected_resources)
	is_object(result.details)
	count(result.details) > 0
	object.get(result.details, "evaluation_status", "undefined") == "indeterminate"
	result.affected_resources == []
}

