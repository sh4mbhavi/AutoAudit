package cis.microsoft_365_foundations.v3_1_0.test_control_1_1_3

import rego.v1

test_compliant if {
	result := data.cis.microsoft_365_foundations.v3_1_0.control_1_1_3.result with input as {"global_admin_count": 3, "global_admins": ["a@contoso.com", "b@contoso.com", "c@contoso.com"]}
	object.get(result, "compliant", "undefined") == true
	is_string(result.message)
	count(result.message) > 0
	is_array(result.affected_resources)
	is_object(result.details)
	count(result.details) > 0
	result.affected_resources == []
}

test_non_compliant_too_few if {
	result := data.cis.microsoft_365_foundations.v3_1_0.control_1_1_3.result with input as {"global_admin_count": 1, "global_admins": ["a@contoso.com"]}
	object.get(result, "compliant", "undefined") == false
	is_string(result.message)
	count(result.message) > 0
	is_array(result.affected_resources)
	is_object(result.details)
	count(result.details) > 0
	count(result.affected_resources) > 0
}

