# AutoAudit local development environment variables
# For local dev, create a `.env` file (gitignored)
#
# Usage:
#   cp env.example .env

# Google SSO
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Required local secrets; generate independent random values before starting Compose.
# POSTGRES_PASSWORD must be URL-safe, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32 (generate independently for each)
SECRET_KEY=
POWERSHELL_SERVICE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Phase 9 collection shape. All optional; the defaults are the reviewed ones.
# GRAPH_MAX_CONCURRENCY   per-collector in-flight Graph requests (default 4)
# POWERSHELL_MAX_BATCH    reviewed operations sharing one remote session (max 25)
# POWERSHELL_MAX_CONCURRENCY  pwsh children one service replica may run (default 4;
#                         Compose sets 2 for the 512M development container)
# GRAPH_MAX_CONCURRENCY=4
# POWERSHELL_MAX_BATCH=25
# POWERSHELL_MAX_CONCURRENCY=4

# Production uses docker-compose.production.yml with explicit HTTPS origins,
# authenticated rediss URLs, and mounted TLS/ACL files. See docs/compliance/phase-5/README.md.
