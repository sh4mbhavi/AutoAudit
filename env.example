# AutoAudit local development environment variables
# For local dev, create a `.env` file (gitignored)
#
# Usage:
#   cp env.example .env

# Google SSO
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Required local secrets; generate independent random values before starting Compose.
# POSTGRES_PASSWORD must be URL-safe, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32 (generate independently for each)
SECRET_KEY=
POWERSHELL_SERVICE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Phase 9 collection shape. All optional; the defaults are the reviewed ones.
# GRAPH_MAX_CONCURRENCY   per-collector in-flight Graph requests (default 4)
# POWERSHELL_MAX_BATCH    reviewed operations sharing one remote session (max 25)
# POWERSHELL_MAX_CONCURRENCY  pwsh children one service replica may run (default 4;
#                         Compose sets 2 for the 512M development container)
# GRAPH_MAX_CONCURRENCY=4
# POWERSHELL_MAX_BATCH=25
# POWERSHELL_MAX_CONCURRENCY=4

# Phase 10 operations settings.
#
# ENCRYPTION_KEY_DECRYPT_ONLY  Retired encryption keys, comma-separated, that may
#     still DECRYPT. Only ENCRYPTION_KEY encrypts. This is what makes a key
#     rotation a window rather than a cutover: deploy the new key as
#     ENCRYPTION_KEY with the previous one listed here, run
#     tools/ops/rotate_encryption_key.py, and only remove the entry once
#     `--check` reports nothing outstanding. Removing it earlier makes every
#     not-yet-rewritten stored credential permanently unreadable.
#     The API and the worker must carry the SAME ring.
# ENCRYPTION_KEY_DECRYPT_ONLY=

# DRIFT_FACT_HMAC_KEY  Keys Phase 8's drift fingerprints. With it UNSET no
#     factprint row is ever written and drift reports `fingerprints_unavailable`
#     -- the feature is delivered but silently off. It appeared in no manifest
#     before Phase 10; docker-compose.production.yml now requires it.
#     Generate with: openssl rand -hex 32
# DRIFT_FACT_HMAC_KEY=

# METRICS_PORT  The dispatcher's Prometheus scrape port. 0 (the default) starts
#     no server, so no existing deployment begins listening on a port its network
#     policy has not been told about. Every alert in
#     infrastructure/monitoring/alerts/scan_lifecycle.yaml reads a gauge this
#     exports. The API serves its own metrics at GET /metrics.
# METRICS_PORT=9101

# Production uses docker-compose.production.yml with explicit HTTPS origins,
# authenticated rediss URLs, and mounted TLS/ACL files. See docs/compliance/phase-5/README.md.
