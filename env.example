# AutoAudit local development environment variables
# For local dev, create a `.env` file (gitignored)
#
# Usage:
#   cp env.example .env

# Google SSO
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Required local secrets; generate independent random values before starting Compose.
# POSTGRES_PASSWORD must be URL-safe, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32 (generate independently for each)
SECRET_KEY=
POWERSHELL_SERVICE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Production uses docker-compose.production.yml with explicit HTTPS origins,
# authenticated rediss URLs, and mounted TLS/ACL files. See docs/compliance/phase-5/README.md.
