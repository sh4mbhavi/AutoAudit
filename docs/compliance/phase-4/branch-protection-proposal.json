{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "Engine tests and policy semantics",
      "Backend tests and migrations",
      "Frontend typecheck tests and build",
      "Linting frontend",
      "API and worker container startup",
      "Scan dependencies for vulnerabilities",
